@page "/register"
@using ClashOfCodes.Services
@using ClashOfCodes.Shared.Models
@inject AuthService AuthService
@inject NavigationManager NavigationManager

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<h3>Register</h3>

<EditForm Model="RegisterFormModel" OnValidSubmit="HandleRegister" FormName="register-form">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="username" class="form-label">Username:</label>
        <InputText id="username" @bind-Value="RegisterFormModel.Username" class="form-control" type="text"
                   placeholder="Enter username" />
    </div>

    <div class="mb-3">
        <label for="email" class="form-label">Email:</label>
        <InputText id="email" @bind-Value="RegisterFormModel.Email" class="form-control" type="email"
                   placeholder="name@example.com" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password:</label>
        <InputText id="password" @bind-Value="RegisterFormModel.Password" class="form-control" type="password"
                   placeholder="Enter password" aria-describedby="passwordHelpBlock" />
        <div id="passwordHelpBlock" class="form-text">
            Your password must be 6 characters long.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@code {
    [SupplyParameterFromForm(FormName = "register-form")]
    private RegisterModel? registerModel { get; set; }

    private RegisterModel RegisterFormModel => registerModel ??= new RegisterModel();

    private string? ErrorMessage;

    private async Task HandleRegister()
    {
        var result = await AuthService.RegisterAsync(RegisterFormModel);
        if (result == "Registration Successful")
            NavigationManager.NavigateTo("/login");
        else
            ErrorMessage = result;
    }
}