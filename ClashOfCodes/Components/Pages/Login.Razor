@page "/login"
@rendermode InteractiveServer
@using ClashOfCodes.Services
@using ClashOfCodes.Shared.Models
@inject AuthService AuthService
@inject NavigationManager NavigationManager

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger">@ErrorMessage</div>
}

<h3>Login</h3>

<EditForm Model="loginModel" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="username" class="form-label">Username:</label>
        <InputText id="username" @bind-Value="loginModel.Username" class="form-control" type="text"
                   placeholder="Enter username" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Password:</label>
        <InputText id="password" @bind-Value="loginModel.Password" class="form-control" type="password"
                   placeholder="Enter password" aria-describedby="passwordHelpBlock" />
        <div id="passwordHelpBlock" class="form-text">
            Your password must be 6 characters long.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Login</button>
</EditForm>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        // send data to AuthService to login the user
        var result = await AuthService.LoginAsync(loginModel);

        if (result)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = "Invalid username or password";
        }
    }
}