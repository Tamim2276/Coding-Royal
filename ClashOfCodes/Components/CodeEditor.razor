@inject IJSRuntime JS

<div id="monaco-editor-container" style="height: 400px; width: 100%; border: 1px solid #444;">
</div>

@code {
    [Parameter] public string Language { get; set; } = "csharp";
    [Parameter] public string InitialCode { get; set; } = "// Write your code here\n";

    // This is called by the parent to get starter code per language
    [Parameter] public Func<string>? GetStarterCode { get; set; }

    private string _previousLanguage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _previousLanguage = Language;
            await JS.InvokeVoidAsync(
                "monacoInterop.initEditor",
                "monaco-editor-container",
                Language,
                InitialCode);
        }
        else if (Language != _previousLanguage)
        {
            _previousLanguage = Language;

            // 1. Update syntax highlighting
            await JS.InvokeVoidAsync("monacoInterop.setLanguage", Language);

            // 2. Replace code with the starter code for the new language
            var newCode = GetStarterCode?.Invoke() ?? "";
            await JS.InvokeVoidAsync("monacoInterop.setValue", newCode);
        }
    }

    public async Task<string> GetCodeAsync()
        => await JS.InvokeAsync<string>("monacoInterop.getCode");
}